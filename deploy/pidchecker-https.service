[Unit]
Description=PID Checker HTTPS gateway (Caddy)
Documentation=https://caddyserver.com/docs/
Wants=network-online.target
After=network-online.target pidchecker.service

[Service]
DynamicUser=yes
StateDirectory=pidchecker-https
StateDirectoryMode=0750
Environment=XDG_DATA_HOME=/var/lib/pidchecker-https
Environment=XDG_CONFIG_HOME=/var/lib/pidchecker-https
EnvironmentFile=/etc/pidchecker/https.env
ExecStart=/opt/pidchecker/caddy run --config /opt/pidchecker/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
