[Unit]
Description=PID Checker web service
Documentation=https://github.com/zijin-c/PIDChecker
Wants=network-online.target
After=network-online.target

[Service]
User=pidchecker
Group=pidchecker
WorkingDirectory=/var/lib/pidchecker
StateDirectory=pidchecker
StateDirectoryMode=0750
ExecStart=/opt/pidchecker/pkc -c /var/lib/pidchecker/config.toml serve
Restart=on-failure
RestartSec=3
# pkc shuts down gracefully on SIGINT and SIGTERM.
KillSignal=SIGINT
TimeoutStopSec=15
LimitNOFILE=65536
UMask=0077

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
