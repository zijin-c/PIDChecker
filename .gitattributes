# Normalise line endings; scripts and container files must stay LF even on Windows checkouts.
* text=auto
*.sh text eol=lf
deploy/* text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf
web/* text eol=lf

# Binary files
*.dll binary
*.ico binary
*.png binary
*.redb binary
